{
  "name": "pookie",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "dev:web": "pnpm --filter @pookie/web dev",
    "dev:worker": "pnpm --filter @pookie/worker dev",
    "build": "pnpm -r run build",
    "db:migrate": "pnpm --filter @pookie/db migrate",
    "parse-resumes": "pnpm --filter @pookie/profile parse"
  },
  "devDependencies": {
    "typescript": "5.6.3",
    "tsx": "4.19.2",
    "@types/node": "22.9.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["better-sqlite3", "esbuild", "sharp"]
  }
}
