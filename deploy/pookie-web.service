[Unit]
Description=Pookie web (Next.js)
After=network-online.target pookie-worker.service
Wants=network-online.target

[Service]
Type=simple
User=pookie
Group=pookie
WorkingDirectory=/opt/pookie/apps/web
EnvironmentFile=-/opt/pookie/.env
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=WORKER_PORT=3001
ExecStart=/usr/bin/pnpm start
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
